# Local dev uses SQLite automatically. In production set a PostgreSQL URL (Neon / Supabase).
# Leave DATABASE_URL unset locally: SQLite is created in ~/.edunexus/edunexus.db (outside the project / OneDrive folder).
# DATABASE_URL=sqlite:///./edunexus.db
JWT_SECRET=put-a-long-random-string-here
# Comma separated list of frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:5173
